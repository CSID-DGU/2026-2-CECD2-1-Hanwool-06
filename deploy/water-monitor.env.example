# /etc/water-monitor.env (root:root, 600). 실제 값은 서버에만 두고 깃에 올리지 않는다.
# 비밀값은 작은따옴표로 감싼다(systemd와 water-cli가 같은 값으로 읽게).
APP_ENV=production
APP_COOKIE_SECURE=true
APP_ORIGINS=https://<서버 공인IP 또는 도메인>
APP_ALLOWED_HOSTS=<서버 공인IP 또는 도메인>
APP_DATA_DIR=/var/lib/water-monitor
ARISU_USER_ID='<아리수 아이디>'
ARISU_USER_PWD='<아리수 비밀번호>'
SEOUL_PSGR_KEY='<승하차 API 키>'
OPENAI_API_KEY='<OpenAI 키>'
OPENAI_MODEL=gpt-6.1-sol
# 채팅의 NCP 읽기 전용 접속. OBJECT_STORAGE_ENABLED를 켜지 않는다.
CHAT_STORAGE_BUCKET=hanwool-data
CHAT_STORAGE_PREFIX=prod
CHAT_STORAGE_ENDPOINT=https://kr.object.ncloudstorage.com
CHAT_STORAGE_REGION=kr-standard
CHAT_STORAGE_ACCESS_KEY='<NCP 읽기용 Access Key>'
CHAT_STORAGE_SECRET_KEY='<NCP 읽기용 Secret Key>'
SMTP_USER='<보내는 Gmail 주소>'
SMTP_PASS='<Gmail 앱 비밀번호>'
ALERT_FROM='<보내는 주소>'

# 운영 DB 없이 새로 시작할 때만(첫 관리자 계정):
# ADMIN_EMAIL=<관리자 이메일>
# ADMIN_PASSWORD='<12자 이상 비밀번호>'

# 08:00 자동 수집을 잠시 멈출 때만:
# COLLECTION_WORKER_ENABLED=false

# Object Storage 보관(back/storage)은 여기에 넣지 않는다(넣으면 웹 안의 자동 훅이 켜진다).
# 매일 14:00 water-storage.sh가 03:30 백업용 키로 hanwool-data/prod/에 올린다(deploy/README.md).
