# macOS
.DS_Store
.AppleDouble
.LSOverride


# Editor directories and files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Python
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
env/
.pyenv/
.venv/

# 환경변수 (credentials — 절대 커밋 금지)
.env
.env.*
!.env.example

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Logs and databases
*.log
*.sqlite3
*.db

# Node
node_modules/

# Build artifacts
dist/
front/dist/
front/demo-dist/
front/dist-single/
front/demo_site.html
front/demo_final.html
build/
*.egg-info/

# Temporary files
*.tmp
*.temp
*~
*.swp
*.swo

# OS generated files
Thumbs.db
ehthumbs.db

# Backup files
*.bak
*.orig
*.rej

# 자료 폴더는 통째로 올리지 않는다. 운영 자료(APP_DATA_DIR, 기본값 data/runtime)와
# 고객번호·역명·사용량이 든 이력 자료(data/runtime/history)는 서버와 Object Storage에만 둔다. CI도 data/ 아래 추적 파일이 없는지 확인한다
/data/

# 과거 공개 스냅샷 (현재 데이터는 인증된 API에서 제공)
front/public/risk.json
front/public/daily.json

# 아리수 원본 엑셀 (용량 크고 재생성 가능)
/archive/data/arisu_station_history/raw/

# 자료가 통째로 들어간 정적 화면 저장본
/front/dist-static/
*.sqlite3-wal
*.sqlite3-shm
/test-results/
# 자동 배포가 화면 빌드를 바꿔 끼울 때 쓰는 폴더
/front/dist.next/
/front/dist.prev/
/front/dist.failed/
